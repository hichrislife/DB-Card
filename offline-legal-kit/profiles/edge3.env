# Edge 3 標準配置：i7-13700E、64GB DDR5（非 ECC）、RTX 5070 Ti 16GB
# 用法：set -a; source profiles/edge3.env; set +a
# 數值是起始建議，實際以 nvidia-smi / free -g 觀察後調整。

# ── 硬體基準（preflight.sh 檢查用）────────────────────────────────
EDGE_MIN_VRAM_MIB=15000
EDGE_MIN_RAM_GB=60
EDGE_MIN_FREE_DISK_GB=200
EDGE_GPU_POWER_LIMIT_W=250          # 300W → 250W，訓練約慢 5–10%，溫度與風扇負擔明顯下降

# ── 路徑 ─────────────────────────────────────────────────────────
TLR_LOCAL_DB=/data/tlr_local.sqlite
TLR_DOCS_ROOT=/data/teams
TWLEGALRAG_TLR_BASE_URL=http://127.0.0.1:8787

# ── 本機 LLM（scripts/start-llm.sh）─────────────────────────────
# 30B 級 MoE、Q4_K_M。expert 權重放系統記憶體（約 18–19GB），GPU 約佔 4–6GB。
# MODEL=/models/<30B 級 MoE>-Q4_K_M.gguf
CPU_MOE=999
CTX=32768
PORT=8080
THREADS=16                          # i7-13700E 有 24 執行緒；保留給 tlr_local、OCR 與 DeepSafe

# ── DeepForge 訓練起始參數（8B、4-bit QLoRA）──────────────────────
TRAIN_BASE_SIZE=8B
TRAIN_SEQ_LEN=4096
TRAIN_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=16
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LR=2e-4
TRAIN_EPOCHS=3
TRAIN_OPTIM=paged_adamw_8bit
TRAIN_GRADIENT_CHECKPOINTING=1
TRAIN_CHECKPOINT_DIR=/nas/checkpoints   # 寫入量最大的部分，放 NAS 或第二顆 SSD
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
