{"UpdateDate": "2026/9/1", "Laws": [{"LawLevel": "法律", "LawName": "民法", "LawURL": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=B0000001", "LawModifiedDate": "20210120", "LawAbandonNote": "", "LawArticles": [{"ArticleType": "C", "ArticleNo": "", "ArticleContent": "第二編 債"}, {"ArticleType": "A", "ArticleNo": "第 184 條", "ArticleContent": "因故意或過失，不法侵害他人之權利者，負損害賠償責任。"}, {"ArticleType": "A", "ArticleNo": "第 252 條", "ArticleContent": "約定之違約金額過高者，法院得減至相當之數額。"}, {"ArticleType": "A", "ArticleNo": "第 191-2 條", "ArticleContent": "汽車、機車或其他非依軌道行駛之動力車輛，在使用中加損害於他人者，駕駛人應賠償因此所生之損害。"}]}, {"LawLevel": "法律", "LawName": "民事訴訟法", "LawURL": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=B0010001", "LawModifiedDate": "20230607", "LawAbandonNote": "", "LawArticles": [{"ArticleType": "A", "ArticleNo": "第 277 條", "ArticleContent": "當事人主張有利於己之事實者，就其事實有舉證之責任。"}]}]}